<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Navigation">
    <Sequence name="main">
      <ReactiveFallback name="navigation">

        <!-- Evitement obstacle -->
        <Sequence name="avoid_obstacle">
          <C_ObstacleDetecte/>
          <A_Reculer/>
          <A_Tourner/>
        </Sequence>

        <!-- Timeout laser -->
        <Sequence name="laser_timeout">
          <C_LaserInactif/>
          <A_Stop/>
        </Sequence>

        <!-- Comportement par defaut -->
        <A_Avancer/>

      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>
</root>
